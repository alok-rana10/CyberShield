# ==============================================================================
# CyberShield - Environment Configuration Template
# NOTE: Copy this file to .env (or backend/.env) for local or production use.
# DO NOT commit production secrets or real credentials to source control.
# ==============================================================================

# Application Environment & Debugging
# In production: APP_ENV must be "production" and DEBUG must be "False"
APP_NAME=CyberShield
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated origins; DO NOT use '*' in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection URL (SQLite default for dev; PostgreSQL for high-concurrency production)
# SQLite:     sqlite:///./data/cybershield.db
# PostgreSQL: postgresql://username:password@localhost:5432/cybershield (Render's postgres:// format auto-normalized)
DATABASE_URL=sqlite:///./data/cybershield.db

# Authentication / JWT Settings
# CRITICAL: In production, JWT_SECRET_KEY must be a random secret of at least 32 characters.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cybershield-dev-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Integrity Monitoring (FIM) Settings
# Comma-separated directory/file paths authorized for baseline monitoring
FIM_ALLOWED_ROOTS=./monitored,./data
FIM_MAX_FILE_SIZE_BYTES=104857600
FIM_MAX_FILES_PER_BASELINE=1000

# Defensive Log Analyzer Settings
# Comma-separated authorized log directories/paths
LOG_ALLOWED_ROOTS=./logs,./data/logs
LOG_MAX_FILE_SIZE_BYTES=52428800
LOG_MAX_LINE_LENGTH=4096
LOG_MAX_LINES_PER_RUN=50000
LOG_BRUTE_FORCE_THRESHOLD=5
LOG_BRUTE_FORCE_WINDOW_SECONDS=300

# Authorized Network Scanner Settings
# Comma-separated authorized scan targets (IP addresses or hostnames)
SCAN_ALLOWED_TARGETS=127.0.0.1,localhost,::1
SCAN_MAX_PORTS_PER_SCAN=100
SCAN_CONNECT_TIMEOUT_SECONDS=1.5
SCAN_MAX_CONCURRENCY=20
SCAN_RATE_LIMIT_PER_MINUTE=10
SCAN_TOTAL_TIMEOUT_SECONDS=30

# Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8000
