# ==============================================================================
# CyberShield - Environment Configuration Template
# NOTE: Copy this file to .env for local development.
# DO NOT commit production secrets or real credentials to source control.
# ==============================================================================

# Application Settings
APP_NAME=CyberShield
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (Defaults to SQLite for local development)
# For PostgreSQL later: postgresql://user:password@localhost:5432/cybershield
DATABASE_URL=sqlite:///./data/cybershield.db

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000
